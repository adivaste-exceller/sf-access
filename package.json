{
  "name": "sf-access-docs",
  "version": "0.1.0",
  "description": "Explore who can access what in a Salesforce org: profiles, permission sets, groups, users.",
  "type": "module",
  "bin": {
    "sf-access-docs": "dist/cli.js"
  },
  "files": [
    "dist",
    "ui-dist"
  ],
  "scripts": {
    "build": "npm run build:cli && npm run build:ui",
    "build:cli": "tsup",
    "build:ui": "vite build",
    "dev:ui": "vite",
    "extract": "tsx src/cli/index.ts extract",
    "serve": "tsx src/cli/index.ts serve",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
